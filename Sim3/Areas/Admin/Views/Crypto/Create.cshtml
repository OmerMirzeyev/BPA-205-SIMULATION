@using Sim3.Areas.Admin.ViewModels.Crypto
@model CreateCryptoVM
<div>
    <form asp-controller="Crypto" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="Name">Name</label>
            <input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Enter Name">
            <span asp-validation-for="@Model.Name"></span>
        </div>
        <div class="form-group">
            <label for="Price">Price</label>
            <input asp-for="@Model.Price" type="text" class="form-control" id="Price" placeholder="Enter Price">
            <span asp-validation-for="@Model.Price"></span>
        </div>
        <div class="form-group">
            <label for="Description">Description</label>
            <input asp-for="@Model.Description" type="text" class="form-control" id="Description" placeholder="Enter Description">
            <span asp-validation-for="@Model.Description"></span>
        </div>
        <div class="form-group">
            <label for="ImageFile">ImageFile</label>
            <input asp-for="@Model.ImageFile" type="file" class="form-control" id="ImageFile" placeholder="Enter ImageFile">
            <span asp-validation-for="@Model.ImageFile"></span>
        </div>
        <div class="form-group">
            <select class="form-select">
                <option disabled selected>Open this select category</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
                </select>
        </div>
<button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

</div>

