@using Sim3.Areas.Admin.ViewModels.Category
@model UpdateCategoryVM
<div>
<form asp-controller="Category" asp-action="Update" method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Enter Name">
        <span asp-validation-for="@Model.Name"></span>
    <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>
</div>