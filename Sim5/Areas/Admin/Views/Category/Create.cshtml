@using Sim5.Areas.Admin.ViewModels.Category
@model CreateCategoryVM
<form asp-controller="Category" asp-action="Create" method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Enter Name">
        <span class="text-danger" asp-validation-for="@Model.Name"></span>
    </div>


    <button type="submit" class="btn btn-primary">Submit</button>
</form>