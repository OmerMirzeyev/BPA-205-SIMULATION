@model List<Product>
<div>
	<table class="table table-bordered">
		<thead>
			<a class="btn btn-primary" asp-controller="Product" asp-action="Create">Create</a>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Name</th>
				<th scope="col">Price</th>
				<th scope="col">Description</th>
				<th scope="col">Category</th>
				<th scope="col">Image</th>
				<th scope="col">DeleteStatus</th>
				<th colspan="2">Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Product product in Model)
			{
				<tr>
					<th scope="row">@product.Id</th>
					<td>@product.Name</td>
					<td>@product.Price</td>
					<td>@product.Description</td>
					<td>@product.Category.Name</td>
					<td>
						<img style="width:90px; height:90px;" src="~/uploads/product/@product.ImageUrl" />
					</td>
					@if (!product.IsDeleted)
					{
						<td class="text-success">Active</td>

					}
					else
					{
						<td class="text-danger">Inactive</td>

					}
					<td>
						<a class="btn btn-primary" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id">Update</a>
					</td>

					<td>
						@if (!product.IsDeleted)
						{
							<form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id">
								<button type="submit" class="btn btn-danger">
									Delete
								</button>

							</form>
						}
						else
						{
							<form asp-controller="Product" asp-action="Restore" asp-route-id="@product.Id">
								<button type="submit" class="btn btn-warning">
									Restore
								</button>
							</form>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>