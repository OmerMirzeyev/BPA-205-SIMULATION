@using Sim4.ViewModels.Account
@model LoginVM
<div>
    <form asp-controller="Account" asp-action="Login" method="post">

        <div class="form-group">
            <label for="Email">Email</label>
            <input asp-for="@Model.Email" type="text" class="form-control" id="Email" placeholder="Enter Email">
                <span asp-validation-for="@Model.Email"></span>
                <label for="Password">Password</label>
                <input asp-for="@Model.Password" type="text" class="form-control" id="Password" placeholder="Enter Password">
                    <span asp-validation-for="@Model.Password"></span>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>