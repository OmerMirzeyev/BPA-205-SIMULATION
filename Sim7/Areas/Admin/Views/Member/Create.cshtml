@using Sim7.Areas.Admin.ViewModels.Member
@model CreateMemberVM
<div>
	<form asp-controller="Member" asp-action="Create" method="post" enctype="multipart/form-data">
		<div class="mb-3">
			<label for="Name" class="form-label">Name</label>
			<input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Add Name">
			<span class="text-danger" asp-validation-for="@Model.Name"></span>
		</div>
		<div class="mb-3">
			<label for="Surname" class="form-label">Surname</label>
			<input asp-for="@Model.Surname" type="text" class="form-control" id="Price" placeholder="Add Surname">
			<span class="text-danger" asp-validation-for="@Model.Surname"></span>
		</div>
		<div class="mb-3">
			<label for="Description" class="form-label">Description</label>
			<input asp-for="@Model.Description" type="text" class="form-control" id="Description" placeholder="Add Description">
			<span class="text-danger" asp-validation-for="@Model.Description"></span>
		</div>
		<select asp-for="@Model.PositionId" class="form-select" aria-label="Default select example">
			<option selected>Open this select menu</option>
			@foreach (var position in ViewBag.Positions)
			{
				<option value="@position.Id">@position.Name</option>
			}
		</select>
		<span class="text-danger" asp-validation-for="@Model.PositionId"></span>
		<div class="mb-3">
			<label for="ImageFile" class="form-label">ImageFile</label>
			<input asp-for="@Model.ImageFile" type="file" class="form-control" id="ImageFile" placeholder="Add ImageFile">
			<span class="text-danger" asp-validation-for="@Model.ImageFile"></span>
		</div>
		<button type="submit" class="btn btn-primary">Submit</button>
	</form>
</div>